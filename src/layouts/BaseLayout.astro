---
import '../styles/global.css';
import {
  SITE_NAME,
  SITE_LOCALE,
  ADSENSE_CLIENT,
  GSC_VERIFICATION,
} from '../consts';
import { withBase } from '../lib/url';

interface Props {
  title: string;
  description: string;
  ogType?: 'website' | 'article';
}

const { title, description, ogType = 'website' } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(withBase('/og-default.png'), Astro.site).href;
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {/* 모바일 브라우저 주소창을 브랜드 컬러로(--accent) + 라이트 스킴 명시
        (다크모드 브라우저에서 흰 배경 사이트의 폼 컨트롤 색 뒤틀림 방지) */}
    <meta name="theme-color" content="#e8612c" />
    <meta name="color-scheme" content="light" />
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    <link rel="canonical" href={canonical} />

    <title>{title}</title>
    <meta name="description" content={description} />

    {/* Google Search Console 소유확인 (consts.ts에 토큰 넣으면 노출) */}
    {GSC_VERIFICATION && (
      <meta name="google-site-verification" content={GSC_VERIFICATION} />
    )}

    <!-- Open Graph (SEO / 공유 미리보기) -->
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:locale" content={SITE_LOCALE} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={SITE_NAME} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="alternate" type="application/rss+xml" title={SITE_NAME} href={withBase('/rss.xml')} />

    <!-- 폰트 CDN preconnect (렌더 차단 폰트 로딩 단축) -->
    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />

    <!-- 한국어 가독성 폰트 -->
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/static/pretendard.min.css"
    />

    {/* 페이지별 구조화 데이터(JSON-LD) 등 추가 head 요소 주입 슬롯 */}
    <slot name="head" />

    {/* AdSense: consts.ts ADSENSE_CLIENT 채우면 자동 삽입 (승인 전엔 미노출) */}
    {ADSENSE_CLIENT && (
      <script
        async
        src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${ADSENSE_CLIENT}`}
        crossorigin="anonymous"></script>
    )}
  </head>
  <body>
    <a href="#main-content" class="skip-link">본문 바로가기</a>
    <header class="site-header">
      <div class="wrap">
        <a href={withBase('/')} class="logo">옳은경제 🧭</a>
        <span class="tagline">복잡한 경제, 바른 방향을 짚어주는</span>
      </div>
    </header>

    <main id="main-content" class="wrap">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap">
        <nav class="footer-nav" aria-label="사이트 정보">
          <a href={withBase('/about/')}>소개</a>
          <span aria-hidden="true">·</span>
          <a href={withBase('/privacy/')}>개인정보처리방침</a>
        </nav>
        <div class="footer-copy">© {new Date().getFullYear()} 옳은경제 · 글린트프로젝트</div>
      </div>
    </footer>
  </body>
</html>
