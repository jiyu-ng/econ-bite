---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE_NAME, SITE_DESCRIPTION } from '../consts';
import { withBase } from '../lib/url';
import { readingMinutes } from '../lib/reading';

const posts = (await getCollection('posts')).sort(
  (a, b) => b.data.publishedDate.getTime() - a.data.publishedDate.getTime()
);

const CATEGORY_ORDER = ['기초 개념', '지표 읽기', '투자', '생활 경제', '경제 뉴스'];
const categories = CATEGORY_ORDER.filter((c) =>
  posts.some((p) => p.data.category === c)
);

const siteUrl = new URL(withBase('/'), Astro.site).href;

// WebSite + ItemList(@graph): 검색엔진이 대표 글 목록을 구조로 이해하도록.
// 최신 20편만 노출(과도한 목록 방지), position은 1부터.
const listItems = posts.slice(0, 20).map((post, i) => ({
  '@type': 'ListItem',
  position: i + 1,
  url: new URL(withBase(`/posts/${post.id}/`), Astro.site).href,
  name: post.data.title,
}));

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      name: SITE_NAME,
      description: SITE_DESCRIPTION,
      url: siteUrl,
      inLanguage: 'ko-KR',
    },
    {
      '@type': 'ItemList',
      name: `${SITE_NAME} 최신 글`,
      itemListOrder: 'https://schema.org/ItemListOrderDescending',
      numberOfItems: listItems.length,
      itemListElement: listItems,
    },
  ],
};
---

<BaseLayout
  title="옳은경제 🧭 — 복잡한 경제, 바른 방향을 짚어주는"
  description="금리·물가·환율부터 투자 기초까지. 어려운 경제를 쉽고 정확하게 정리하는 사이트."
>
  <script
    type="application/ld+json"
    slot="head"
    set:html={JSON.stringify(jsonLd)}
  />
  {/* 페이지 대표 제목 — 시각적으로는 헤더 로고가 대신하므로 숨김 처리.
      검색엔진·스크린리더의 h1 단일성/문서 구조를 위해 반드시 존재해야 함 */}
  <h1 class="sr-only">옳은경제 — 복잡한 경제를 쉽고 정확하게 정리하는 경제 정보 사이트</h1>

  <!-- 카테고리 네비게이션 -->
  <nav class="cat-nav" aria-label="카테고리">
    {categories.map((c) => (
      <a class="cat-chip" href={withBase(`/category/${c}/`)}>{c}</a>
    ))}
  </nav>

  <!-- 상단 광고 슬롯 -->
  <div class="ad-slot">광고 영역 (AdSense 승인 후 노출)</div>

  <ul class="card-list">
    {
      posts.map((post) => (
        <li>
          <a class="card" href={withBase(`/posts/${post.id}/`)}>
            <span class="category">{post.data.category}</span>
            <h2>{post.data.title}</h2>
            <p>{post.data.description}</p>
            <div class="card-meta">
              <time datetime={post.data.publishedDate.toISOString().slice(0, 10)}>
                {post.data.publishedDate.toLocaleDateString('ko-KR')}
              </time>
              <span aria-hidden="true">·</span>
              <span>📖 약 {readingMinutes(post.body)}분</span>
            </div>
          </a>
        </li>
      ))
    }
  </ul>
</BaseLayout>
