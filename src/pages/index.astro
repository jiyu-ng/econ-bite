---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE_NAME, SITE_DESCRIPTION } from '../consts';
import { withBase } from '../lib/url';

const posts = (await getCollection('posts')).sort(
  (a, b) => b.data.publishedDate.getTime() - a.data.publishedDate.getTime()
);

const CATEGORY_ORDER = ['기초 개념', '지표 읽기', '투자', '생활 경제', '경제 뉴스'];
const categories = CATEGORY_ORDER.filter((c) =>
  posts.some((p) => p.data.category === c)
);

const siteUrl = new URL(withBase('/'), Astro.site).href;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE_NAME,
  description: SITE_DESCRIPTION,
  url: siteUrl,
  inLanguage: 'ko-KR',
};
---

<BaseLayout
  title="경제한입 🍱 — 하루 한입, 쉬워지는 경제"
  description="금리·물가·환율부터 투자 기초까지. 어려운 경제를 한입 크기로 잘라 쉽게 정리하는 사이트."
>
  <script
    type="application/ld+json"
    slot="head"
    set:html={JSON.stringify(jsonLd)}
  />
  <!-- 카테고리 네비게이션 -->
  <nav class="cat-nav" aria-label="카테고리">
    {categories.map((c) => (
      <a class="cat-chip" href={withBase(`/category/${c}/`)}>{c}</a>
    ))}
  </nav>

  <!-- 상단 광고 슬롯 -->
  <div class="ad-slot">광고 영역 (AdSense 승인 후 노출)</div>

  <ul class="card-list">
    {
      posts.map((post) => (
        <li>
          <a class="card" href={withBase(`/posts/${post.id}/`)}>
            <span class="category">{post.data.category}</span>
            <h2>{post.data.title}</h2>
            <p>{post.data.description}</p>
            <time class="card-date" datetime={post.data.publishedDate.toISOString().slice(0, 10)}>
              {post.data.publishedDate.toLocaleDateString('ko-KR')}
            </time>
          </a>
        </li>
      ))
    }
  </ul>
</BaseLayout>
