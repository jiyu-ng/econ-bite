---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE_NAME } from '../../consts';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post, allPosts: posts },
  }));
}

const { post, allPosts } = Astro.props;
const { Content } = await render(post);

const published = post.data.publishedDate;
const dateLabel = published.toLocaleDateString('ko-KR', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const canonical = new URL(Astro.url.pathname, Astro.site);
const siteUrl = new URL('/', Astro.site).href;

// 관련 글: 같은 카테고리 우선, 최신순, 현재 글 제외, 최대 3개
const sameCategory = allPosts
  .filter((p) => p.id !== post.id && p.data.category === post.data.category)
  .sort((a, b) => b.data.publishedDate.getTime() - a.data.publishedDate.getTime());

const others = allPosts
  .filter((p) => p.id !== post.id && p.data.category !== post.data.category)
  .sort((a, b) => b.data.publishedDate.getTime() - a.data.publishedDate.getTime());

const relatedPosts = [...sameCategory, ...others].slice(0, 3);

// 카테고리명 → URL 슬러그 변환 (한글 포함 URL 안전)
const categorySlug = encodeURIComponent(post.data.category);
const categoryUrl = new URL(`/category/${categorySlug}/`, Astro.site).href;

// 검색결과 리치 표시용 구조화 데이터: Article + BreadcrumbList (@graph)
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Article',
      headline: post.data.title,
      description: post.data.description,
      datePublished: published.toISOString(),
      inLanguage: 'ko-KR',
      articleSection: post.data.category,
      keywords: post.data.tags?.join(', ') || undefined,
      mainEntityOfPage: { '@type': 'WebPage', '@id': canonical.href },
      author: { '@type': 'Organization', name: SITE_NAME },
      publisher: { '@type': 'Organization', name: SITE_NAME },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: SITE_NAME, item: siteUrl },
        { '@type': 'ListItem', position: 2, name: post.data.category, item: categoryUrl },
        { '@type': 'ListItem', position: 3, name: post.data.title, item: canonical.href },
      ],
    },
  ],
};
---

<BaseLayout
  title={`${post.data.title} — 경제한입`}
  description={post.data.description}
  ogType="article"
>
  <script
    type="application/ld+json"
    slot="head"
    set:html={JSON.stringify(jsonLd)}
  />
  {/* Open Graph article 메타 (소셜 공유·검색 리치) */}
  <meta property="article:published_time" content={published.toISOString()} slot="head" />
  <meta property="article:section" content={post.data.category} slot="head" />
  <nav class="breadcrumb" aria-label="breadcrumb">
    <ol>
      <li><a href="/">{SITE_NAME}</a></li>
      <li><span>{post.data.category}</span></li>
      <li><span>{post.data.title}</span></li>
    </ol>
  </nav>
  <article class="post">
    <a class="category" href={`/category/${post.data.category}/`}>{post.data.category}</a>
    <h1>{post.data.title}</h1>
    <p class="meta">
      <time datetime={published.toISOString().slice(0, 10)}>{dateLabel}</time>
    </p>

    <Content />

    {post.data.tags && post.data.tags.length > 0 && (
      <div class="tag-list" role="list" aria-label="태그">
        {post.data.tags.map((tag: string) => (
          <a class="tag-chip" href={`/tags/${tag}/`} role="listitem">#{tag}</a>
        ))}
      </div>
    )}

    <!-- 본문 하단 광고 슬롯 -->
    <div class="ad-slot">광고 영역 (AdSense 승인 후 노출)</div>
  </article>

  {relatedPosts.length > 0 && (
    <section class="related-posts">
      <h2 class="related-posts__heading">관련 글</h2>
      <ul class="card-list">
        {relatedPosts.map((p) => (
          <li>
            <a class="card" href={`/posts/${p.id}/`}>
              <span class="category">{p.data.category}</span>
              <h3>{p.data.title}</h3>
              <p>{p.data.description}</p>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}

  <a class="back-link" href="/">← 목록으로</a>
</BaseLayout>
