---
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../lib/url';
---

<BaseLayout
  title="페이지를 찾을 수 없어요 — 경제한입 🍱"
  description="요청하신 페이지가 존재하지 않습니다. 경제한입 홈으로 돌아가세요."
>
  <div class="not-found">
    <p class="not-found__code">404</p>
    <h1 class="not-found__title">페이지를 찾을 수 없어요</h1>
    <p class="not-found__desc">
      주소가 잘못되었거나 삭제된 페이지입니다.<br />
      경제한입 홈에서 다른 글을 찾아보세요.
    </p>
    <a href={withBase('/')} class="not-found__btn">홈으로 돌아가기</a>
  </div>
</BaseLayout>

<style>
  .not-found {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 80px 20px 100px;
  }
  .not-found__code {
    font-size: 5rem;
    font-weight: 900;
    color: var(--accent);
    margin: 0 0 8px;
    letter-spacing: -0.04em;
    line-height: 1;
  }
  .not-found__title {
    font-size: 1.6rem;
    font-weight: 800;
    color: var(--ink);
    margin: 0 0 16px;
    letter-spacing: -0.02em;
  }
  .not-found__desc {
    font-size: 1rem;
    color: var(--muted);
    line-height: 1.8;
    margin: 0 0 32px;
  }
  .not-found__btn {
    display: inline-block;
    background: var(--accent);
    color: #fff;
    font-weight: 700;
    font-size: 0.95rem;
    padding: 12px 28px;
    border-radius: 999px;
    transition: opacity 0.15s ease;
  }
  .not-found__btn:hover {
    opacity: 0.85;
    text-decoration: none;
  }
</style>
